{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["check", "^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/**", ".vercel/output/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "check": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  },
  "ui": "stream",
  "globalDependencies": ["eslint.config.mjs", ".prettierignore"]
}
