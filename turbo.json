{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["check", "^build"],
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**",
        ".astro/**",
        ".vercel/output/**"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "check": {
      "outputs": [
        ".svelte-kit/tsconfig.json",
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/non-ambient.d.ts",
        ".svelte-kit/types/**",
        ".svelte-kit/generated/**",
        ".astro/**"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  },
  "ui": "stream",
  "globalDependencies": ["eslint.config.mjs", ".prettierignore"]
}
